# OT-ICS lab Suricata rules (SID range 9000001-9000999)
# Rendered by the ot_sensor role with this range's asset IPs.
# Each rule is tagged with its ATT&CK for ICS technique in metadata.
#
# PLC={{ ot_assets.plc }} HMI={{ ot_assets.hmi }} FIELD={{ ot_assets.field_io }} EWS={{ ot_assets.ews }}

# --- Unauthorized command / manipulation of control ------------------------
alert modbus ![{{ ot_assets.hmi }},{{ ot_assets.field_io }},{{ ot_assets.ews }}] any -> {{ ot_assets.plc }} 502 (msg:"OTLAB Modbus write from unauthorized host"; modbus: access write; classtype:attempted-admin; metadata: attack_ics T0855, zone control; sid:9000001; rev:1;)

alert modbus ![{{ ot_assets.hmi }},{{ ot_assets.ews }}] any -> {{ ot_assets.plc }} 502 (msg:"OTLAB Modbus write to setpoint registers from non-HMI host"; modbus: access write holding, address >1024; classtype:attempted-admin; metadata: attack_ics T0836; sid:9000002; rev:1;)

alert modbus any any -> {{ ot_assets.plc }} 502 (msg:"OTLAB Modbus write to mode_auto coil (AUTO/MANUAL change)"; modbus: access write coils; classtype:policy-violation; metadata: attack_ics T0858; sid:9000003; rev:1;)

# --- Discovery ---------------------------------------------------------------
alert modbus any any -> any 502 (msg:"OTLAB Modbus Report Server ID (FC17) - device fingerprinting"; modbus: function 17; classtype:attempted-recon; metadata: attack_ics T0888; sid:9000010; rev:1;)

alert modbus any any -> any 502 (msg:"OTLAB Modbus Read Device Identification (FC43/14)"; modbus: function 43; classtype:attempted-recon; metadata: attack_ics T0888; sid:9000011; rev:1;)

alert tcp ![{{ ot_nets.supervisory }},{{ ot_nets.control }}] any -> {{ ot_nets.control }} 502 (msg:"OTLAB Modbus/TCP connection into control zone from outside supervisory zone"; flow:to_server; flags:S; classtype:policy-violation; metadata: attack_ics T0846, purdue conduit-violation; sid:9000012; rev:1;)

alert tcp any any -> {{ ot_nets.control }} 502 (msg:"OTLAB Possible Modbus scan - many SYNs to 502"; flow:to_server; flags:S; detection_filter: track by_src, count 10, seconds 30; classtype:attempted-recon; metadata: attack_ics T0846; sid:9000013; rev:1;)

# --- Inhibit response / impair process control --------------------------------
alert modbus any any -> any 502 (msg:"OTLAB Modbus Diagnostics Force Listen Only Mode (FC8/4)"; modbus: function 8, subfunction 4; classtype:attempted-dos; metadata: attack_ics T0814; sid:9000020; rev:1;)

alert modbus any any -> any 502 (msg:"OTLAB Modbus Diagnostics Restart Communications (FC8/1)"; modbus: function 8, subfunction 1; classtype:attempted-dos; metadata: attack_ics T0816; sid:9000021; rev:1;)

alert tcp any any -> {{ ot_assets.plc }} 502 (msg:"OTLAB Modbus request flood against PLC"; flow:to_server,established; dsize:>7; threshold: type both, track by_src, count 300, seconds 10; classtype:attempted-dos; metadata: attack_ics T0814; sid:9000022; rev:1;)

# --- Controller programming / default creds (OpenPLC web on 8080) -------------
alert http any any -> {{ ot_assets.plc }} 8080 (msg:"OTLAB OpenPLC login attempt with default credentials"; flow:to_server,established; http.method; content:"POST"; http.uri; content:"/login"; http.request_body; content:"username=openplc"; content:"password=openplc"; distance:0; classtype:default-login-attempt; metadata: attack_ics T0812; sid:9000030; rev:1;)

alert http ![{{ ot_assets.ews }}] any -> {{ ot_assets.plc }} 8080 (msg:"OTLAB OpenPLC program upload from non-EWS host"; flow:to_server,established; http.method; content:"POST"; http.uri; content:"/upload-program"; classtype:attempted-admin; metadata: attack_ics T0843; sid:9000031; rev:1;)

alert http any any -> {{ ot_assets.plc }} 8080 (msg:"OTLAB OpenPLC runtime stop requested"; flow:to_server,established; http.uri; content:"/stop_plc"; classtype:attempted-dos; metadata: attack_ics T0881; sid:9000032; rev:1;)

alert http any any -> {{ ot_assets.plc }} 8080 (msg:"OTLAB OpenPLC program compile/launch"; flow:to_server,established; http.uri; content:"/compile-program"; classtype:policy-violation; metadata: attack_ics T0821; sid:9000033; rev:1;)

# --- IT -> OT pivot -------------------------------------------------------------
alert tcp {{ ot_nets.enterprise }} any -> [{{ ot_nets.supervisory }},{{ ot_nets.control }}] any (msg:"OTLAB Direct connection from Enterprise IT into OT zone (bypassing IDMZ)"; flow:to_server; flags:S; classtype:policy-violation; metadata: attack_ics T0886, purdue conduit-violation; sid:9000040; rev:1;)

alert tcp {{ ot_nets.attacker }} any -> [{{ ot_nets.idmz }},{{ ot_nets.supervisory }},{{ ot_nets.control }}] any (msg:"OTLAB Untrusted network touching OT/IDMZ"; flow:to_server; flags:S; classtype:policy-violation; metadata: attack_ics T0886; sid:9000041; rev:1;)
